<Window x:Class="VegaBeamTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VegaBeamTool" 
        xmlns:local1="clr-namespace:VegaBeamTool.CameraUI"
        mc:Ignorable="d"
        
        Title="VegaBeamTool" Height="1000" Width="1500">
    <Window.Resources>
        <Style x:Key="BSSBorder" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Black"/>
        </Style>
    </Window.Resources>
    <Grid>
        <ContentControl  Content="{Binding CameraShowView}">
        </ContentControl>
    </Grid>
</Window>
