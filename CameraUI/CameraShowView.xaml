<UserControl x:Class="VegaBeamTool.CameraUI.CameraShowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VegaBeamTool.CameraUI"
             mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1000" Background="White">
    <UserControl.Resources>
        <Style x:Key="TextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="20"/>
        </Style>
        <Style x:Key="BorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0" Header="Coordinate Record" BorderThickness="2" BorderBrush="Black">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>
                        <Border>
                            <ContentControl Content="{Binding RecordTable}"/>
                        </Border>
                        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="0,0.5,0,0">
                            <Button  Content="Record" Command="{Binding CoordinateRecordCommand}" Width="80" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </GroupBox>
                <GroupBox Grid.Column="1"  Header="Beam Image" BorderThickness="2" BorderBrush="Black">
                    <Grid x:Name="ImageContainerGrid">
                        <ScrollViewer x:Name="MainScrollViewer"
                              HorizontalScrollBarVisibility="Visible"
                              VerticalScrollBarVisibility="Visible">
                            <Grid>
                                <Image x:Name="DisplayImage"
                                        Stretch="None"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Source="{Binding CameraImage}">
                                </Image>
                                <Canvas x:Name="ContourCanvas"
                                         IsHitTestVisible="False"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top"
                                         Width="{Binding ActualWidth, ElementName=DisplayImage}"
                                         Height="{Binding ActualHeight, ElementName=DisplayImage}">
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                        <Canvas IsHitTestVisible="False" ClipToBounds="False">
                            <TextBlock x:Name="PixelInfoText"
                                       FontSize="12"
                                       Foreground="White"
                                       Background="#80000000"
                                       Padding="4,2"
                                       Visibility="Collapsed"/>
                        </Canvas>
                    </Grid>
                </GroupBox>
            </Grid>
            <Grid Grid.Row="1">
                <GroupBox Grid.Column="1" Header="Beam" BorderBrush="Black" BorderThickness="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Border Grid.Column="0" 
                         Grid.Row="0" 
                         BorderThickness ="0.5,0.5,0,0"
                         Style="{StaticResource BorderStyle}">
                            <TextBlock Text="Center X" Width="70" Height="20" Style="{StaticResource TextStyle}"/>
                        </Border>
                        <Border Grid.Column="1" 
                         Grid.Row="0" 
                         BorderThickness ="0.5,0.5,0,0"
                         Style="{StaticResource BorderStyle}">
                            <TextBlock Text="{Binding BeamXValue, StringFormat={}{0:F2}}" Width="100" Height="20" Style="{StaticResource TextStyle}"/>
                        </Border>
                        <Border Grid.Column="2" 
                         Grid.Row="0" 
                         BorderThickness ="0.5,0.5,0,0"
                         Style="{StaticResource BorderStyle}">
                            <TextBlock Text="Center Y" Width="70" Height="20" Style="{StaticResource TextStyle}"/>
                        </Border>
                        <Border Grid.Column="3" 
                         Grid.Row="0" 
                         BorderThickness ="0.5,0.5,0.5,0"
                         Style="{StaticResource BorderStyle}">
                            <TextBlock Text="{Binding BeamYValue, StringFormat={}{0:F2}}" Width="100" Height="20" Style="{StaticResource TextStyle}"/>
                        </Border>
                        <Border Grid.Column="0" 
                         Grid.Row="1" 
                         BorderThickness ="0.5,0.5,0,0"
                         Style="{StaticResource BorderStyle}">
                            <TextBlock Text="Radius X" Width="70" Height="20" Style="{StaticResource TextStyle}"/>
                        </Border>
                        <Border Grid.Column="1" 
                         Grid.Row="1" 
                         BorderThickness ="0.5,0.5,0,0"
                         Style="{StaticResource BorderStyle}">
                            <TextBlock Text="{Binding RadiusXValue, StringFormat={}{0:F2}}" Width="100" Height="20" Style="{StaticResource TextStyle}"/>
                        </Border>
                        <Border Grid.Column="2" 
                         Grid.Row="1" 
                         BorderThickness ="0.5,0.5,0,0"
                         Style="{StaticResource BorderStyle}">
                            <TextBlock Text="Radius Y" Width="70" Height="20" Style="{StaticResource TextStyle}"/>
                        </Border>
                        <Border Grid.Column="3" 
                         Grid.Row="1" 
                         BorderThickness ="0.5,0.5,0.5,0"
                         Style="{StaticResource BorderStyle}">
                            <TextBlock Text="{Binding RadiusYValue, StringFormat={}{0:F2}}" Width="100" Height="20" Style="{StaticResource TextStyle}"/>
                        </Border>
                        <Border Grid.Column="0" 
                         Grid.Row="2" 
                         BorderThickness ="0.5,0.5,0,0"
                         Style="{StaticResource BorderStyle}">
                            <TextBlock Text="LongAxis" Width="70" Height="20" Style="{StaticResource TextStyle}"/>
                        </Border>
                        <Border Grid.Column="1" 
                         Grid.Row="2" 
                         BorderThickness ="0.5,0.5,0,0"
                         Style="{StaticResource BorderStyle}">
                            <TextBlock Text="{Binding LongAxisValue, StringFormat={}{0:F2}}" Width="100" Height="20" Style="{StaticResource TextStyle}"/>
                        </Border>

                        <Border Grid.Column="2" 
                         Grid.Row="2" 
                         BorderThickness ="0.5,0.5,0,0"
                         Style="{StaticResource BorderStyle}">
                            <TextBlock Text="ShortAxis" Width="70" Height="20" Style="{StaticResource TextStyle}"/>
                        </Border>
                        <Border Grid.Column="3" 
                         Grid.Row="2" 
                         BorderThickness ="0.5,0.5,0.5,0"
                         Style="{StaticResource BorderStyle}">
                            <TextBlock Text="{Binding ShortAxisValue, StringFormat={}{0:F2}}" Width="100" Height="20" Style="{StaticResource TextStyle}"/>
                        </Border>

                        <Border Grid.Column="0" 
                         Grid.Row="3" 
                         BorderThickness ="0.5,0.5,0,0.5"
                         Style="{StaticResource BorderStyle}">
                            <TextBlock Text="TiltAngle" Width="70" Height="20" Style="{StaticResource TextStyle}"/>
                        </Border>
                        <Border Grid.Column="1" 
                         Grid.Row="3" 
                         BorderThickness ="0.5,0.5,0,0.5"
                         Style="{StaticResource BorderStyle}">
                            <TextBlock Text="{Binding TiltAngleValue, StringFormat={}{0:F2}}" Width="100" Height="20" Style="{StaticResource TextStyle}"/>
                        </Border>
                        <Border Grid.Column="2"
                         Grid.Row="3"
                         BorderThickness="0.5,0.5,0,0.5"
                         Style="{StaticResource BorderStyle}">
                        </Border>
                        <Border Grid.Column="3"
                         Grid.Row="3"
                         BorderThickness="0.5,0.5,0.5,0.5"
                         Style="{StaticResource BorderStyle}">
                        </Border>

                    </Grid>

                </GroupBox>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <GroupBox Header="Camera Control" BorderBrush="Black" BorderThickness="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Row="0" Content="StartCamera" Command="{Binding StartCameraCommand}" IsEnabled="{Binding CameraStartStatus}" Style="{StaticResource ButtonStyle}"/>
                            <Button Grid.Row="1" Content="StopCamera" Command="{Binding StopCameraCommand}" IsEnabled="{Binding CameraStopStatus}" Style="{StaticResource ButtonStyle}"/>
                            <Button Grid.Row="2" Content="Capture" Command="{Binding StartCaptureCommand}" IsEnabled="{Binding CameraStopStatus}" Style="{StaticResource ButtonStyle}"/>
                            <Button Grid.Row="3" Content="Snapshot" Command="{Binding StartSnapshotCommand}" IsEnabled="{Binding CameraStopStatus}" Style="{StaticResource ButtonStyle}"/>
                            <Button Grid.Row="4" Content="SaveImage" Command="{Binding SaveImageCommand}" IsEnabled="{Binding CameraStopStatus}" Style="{StaticResource ButtonStyle}"/>
                            <!--<Button Grid.Row="5" Content="{Binding RecordStatus}" Command="{Binding SaveRecordFiledCommand}" Background="{Binding RecordStatusBackground}" IsEnabled="{Binding CameraStopStatus}" Style="{StaticResource ButtonStyle}"/>-->
                            <!--<Button Grid.Row="6" Content="{Binding TestText}" Command="{Binding TestImageCommand}" Style="{StaticResource ButtonStyle}"/>-->
                        </Grid>
                    </GroupBox>
                </Grid>
                <GroupBox Grid.Column="1" Header="Config" BorderThickness="2" BorderBrush="Black">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" 
                             Grid.Row="0" 
                             BorderThickness ="0.5,0.5,0,0"
                             Style="{StaticResource BorderStyle}">
                                <TextBlock Text="SN" Width="20" Height="20" Style="{StaticResource TextStyle}"/>
                            </Border>
                            <Border Grid.Column="1"
                             Grid.Row="0" 
                             BorderThickness="0.5,0.5,0,0"
                             Style="{StaticResource BorderStyle}">
                                <TextBox Text="{Binding SNValue}" Width="100" Height="20" FontSize="10" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" 
                             Grid.Row="0" 
                             BorderThickness ="0.5,0.5,0,0"
                             Style="{StaticResource BorderStyle}">
                                <TextBlock Text="ExposureTime" Width="95" Height="20" Style="{StaticResource TextStyle}"/>
                            </Border>
                            <Border Grid.Column="1"
                             Grid.Row="0" 
                             BorderThickness="0.5,0.5,0,0"
                             Style="{StaticResource BorderStyle}">
                                <TextBox Text="{Binding ExposureTimeValue}" Width="100" Height="20" FontSize="10" HorizontalAlignment="Center">
                                    <!--<Binding Path="ExposureTimeValue" UpdateSourceTrigger="PropertyChanged">
                                 <Binding.ValidationRules>
                                     <local:ExposureTimeValidationRule/>
                                 </Binding.ValidationRules>
                             </Binding>-->
                                </TextBox>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" 
                             Grid.Row="0" 
                             BorderThickness ="0.5,0.5,0,0"
                             Style="{StaticResource BorderStyle}">
                                <TextBlock Text="GlobalGain" Width="75" Height="20" Style="{StaticResource TextStyle}"/>
                            </Border>
                            <Border Grid.Column="1"
                             Grid.Row="0" 
                             BorderThickness="0.5,0.5,0,0"
                             Style="{StaticResource BorderStyle}">
                                <TextBox Text="{Binding GlobalGainValue}" Width="100" Height="20" FontSize="10" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="3" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" 
                                    Grid.Row="0" 
                                    BorderThickness ="0.5,0.5,0,0.5"
                                    Style="{StaticResource BorderStyle}">
                                <TextBlock Text="Coefficient" Width="75" Height="20" Style="{StaticResource TextStyle}"/>
                            </Border>
                            <Border Grid.Column="1"
                                    Grid.Row="0" 
                                    BorderThickness="0.5,0.5,0,0.5"
                                    Style="{StaticResource BorderStyle}">
                                <TextBox Text="{Binding CoefficientValue}" Width="100" Height="20" FontSize="10" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" 
                                    Grid.Row="0" 
                                    BorderThickness ="0.5,0.5,0,0"
                                    Style="{StaticResource BorderStyle}">
                                <TextBlock Text="Average Times" Height="20" Style="{StaticResource TextStyle}"/>
                            </Border>
                            <Border Grid.Column="1"
                                    Grid.Row="0" 
                                    BorderThickness="0.5,0.5,0.5,0"
                                    Style="{StaticResource BorderStyle}">
                                <TextBox Text="{Binding AverageTimesValue}" Width="100" Height="20" FontSize="10" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="2">
                            <Border BorderThickness ="0.5,0.5,0.5,0"  Style="{StaticResource BorderStyle}">
                                <TextBlock Text="{Binding SelectPathValue}" Height="20" Style="{StaticResource TextStyle}"/>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2" Grid.Column="2">
                            <Border BorderThickness="0.5,0,0.5,0" Style="{StaticResource BorderStyle}">
                                <Button Width="150" Content="SelectSaveImagePath" Command="{Binding SelectSaveImagePathCommand}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Grid Grid.Row="3" Grid.Column="2">
                            <Border BorderThickness="0.5,0.5,0.5,0.5" Style="{StaticResource BorderStyle}">
                                <Button Grid.Column="2" Grid.Row="3" Width="80" Content="SaveConfig" Command="{Binding SaveConfigCommand}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                      </Grid>

                </GroupBox>
            </Grid>
        </Grid>
        <GroupBox Grid.Column="1" Header="Beam Profiles" BorderThickness="2" BorderBrush="Black">
            <ItemsControl ItemsSource="{Binding LineSeriesElement}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="4" Columns="1">
                        </UniformGrid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </GroupBox>
    </Grid>
</UserControl>
