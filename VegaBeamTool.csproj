<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- TUCam.dll 与大恒 SDK 均为原生 x64，产物必须是 64 位。
		     这里只设 PlatformTarget，不设 Platforms，否则解决方案的 Any CPU 配置会映射不到本项目。 -->
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<!-- codesamples 是厂商 SDK 示例、Tools 是独立自检工具，均不参与主程序编译 -->
	<ItemGroup>
		<Compile Remove="codesamples\**;Tools\**" />
		<Page Remove="codesamples\**;Tools\**" />
		<Resource Remove="codesamples\**;Tools\**" />
		<None Remove="codesamples\**;Tools\**" />
		<EmbeddedResource Remove="codesamples\**;Tools\**" />
	</ItemGroup>

	<!-- 厂商提供的 P/Invoke 声明文件，保持与官方 SDK 一致，不为其修补告警 -->
	<ItemGroup>
		<Compile Update="Camera\Tucsen\TUCamera.cs">
			<NoWarn>CS0649;CS0169;CS0414;CS8618;CS8625</NoWarn>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Autofac" Version="8.1.1" />
		<PackageReference Include="Autofac.Extras.DynamicProxy" Version="7.1.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
		<PackageReference Include="MathNet.Numerics" Version="5.0.0" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
		<PackageReference Include="MongoDB.Driver" Version="3.0.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="NLog" Version="5.3.4" />
		<PackageReference Include="OpenCvSharp4" Version="4.10.0.20241107" />
		<PackageReference Include="OpenCvSharp4.Extensions" Version="4.10.0.20241107" />
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241107" />
		<PackageReference Include="OxyPlot.Core" Version="2.2.0" />
		<PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
		<PackageReference Include="Serilog" Version="4.0.2" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
		<PackageReference Include="System.Drawing.Common" Version="8.0.8" />
		<PackageReference Include="System.IO.Ports" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="GxIAPINET">
	    <HintPath>Camera\GxIAPINET.dll</HintPath>
	  </Reference>
	</ItemGroup>
	
	<ItemGroup>
		<None Update="nlog.config">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
